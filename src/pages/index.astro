---
const profile = {
  name: 'Dongxu (Allen) Hu',
  role: 'Senior Network Engineer',
  location: 'Waterloo, Canada',
  summary:
    'I design, operate, and modernize large-scale enterprise networks across data centers, branch offices, public cloud, SDN, SD-WAN, and security platforms.',
  email: 'hudongxu31@gmail.com',
  linkedin: 'https://www.linkedin.com/in/your-linkedin/',
  github: 'https://github.com/allenhu31',
};

const metrics = [
  { value: '270+', label: 'member companies supported through hybrid network operations' },
  { value: '200+', label: 'global sites optimized through SD-WAN migration' },
  { value: '99.9%', label: 'availability target delivered in enterprise network environments' },
  { value: 'RMB 6M+', label: 'annual cost reduction from WAN optimization' },
];

const skills = [
  {
    group: 'Networking',
    items: ['BGP', 'OSPF', 'EIGRP', 'MPLS', 'VLAN', 'STP', 'VPN', 'NAT', 'DHCP', 'QoS', 'VRRP'],
  },
  {
    group: 'Cloud & SDN',
    items: ['AWS', 'GCP', 'Huawei Cloud', 'VMware NSX', 'H3C Fabric', 'VXLAN', 'SD-WAN'],
  },
  {
    group: 'Automation & Platforms',
    items: ['Python', 'Golang', 'Ansible', 'CI/CD', 'Docker', 'Kubernetes', 'Prometheus', 'Grafana', 'Zabbix'],
  },
  {
    group: 'Security & Troubleshooting',
    items: ['Cisco ASA', 'Fortinet', 'Palo Alto', 'WAF', 'DDoS Protection', 'IDS/IPS', 'Wireshark', 'Tcpdump', 'MTR'],
  },
];

const experiences = [
  {
    title: 'Core Network Engineer',
    company: 'China Resources Gas / Runzhi Technology - Zhongshan, China',
    period: '2023.01 - 2024.02',
    stack: ['AWS', 'Huawei Cloud', 'BGP/MPLS', 'OSPF', 'VPC', 'ECS', 'WAF', 'Firewall ACL', 'SCADA'],
    bullets: [
      'Operated AWS and Huawei Cloud environments, including subnet and VPC planning, ECS resources, storage planning, capacity management, and cost management.',
      'Built and maintained connectivity among Zhongshan office, Huawei Cloud, Shanwei data center, Zhengzhou data center, and multiple POP sites.',
      'Standardized network architecture and security practices for 270 China Resources Gas member companies.',
      'Optimized the SCADA core network, including firewall rule redesign and Huawei Cloud core network device migration and upgrade.',
    ],
  },
  {
    title: 'Network Architect',
    company: 'Sangfor Technologies Inc. - Shenzhen, China',
    period: '2021.11 - 2022.12',
    stack: ['Hosted Cloud', 'HCI', 'SDN', 'SRE', 'DevOps', 'CMDB', 'Change Management'],
    bullets: [
      'Owned national hosted-cloud network architecture across 45 self-built nodes and 20 partner-built nodes.',
      'Designed, delivered, and operated hosted cloud and hyper-converged infrastructure, connecting physical network logic with cloud service delivery.',
      'Defined infrastructure operation processes with delivery, SRE, and hyper-converged R&D teams.',
      'Guided the operations development team on DevOps framework design, including change request systems, CMDB, and workflow systems.',
    ],
  },
  {
    title: 'Network Architecture & Operations Lead',
    company: 'Country Garden Group - Foshan, China',
    period: '2021.02 - 2021.11',
    stack: ['SD-WAN', 'BGP', 'Cisco ASR', 'Fortinet', 'VXLAN', 'Wi-Fi 6', 'ITSM', 'Private Cloud SDN'],
    bullets: [
      'Led network optimization across three data centers and two large campus networks.',
      'Drove private cloud network operations and new private cloud construction, including tender support, equipment selection, and architecture documentation.',
      'Converted 200+ regional site connections from BGP dual-line routing to SD-WAN path selection while preserving service quality and reducing network cost by 50%.',
      'Led security audit, compliance, emergency drills, WAF, firewall, IDS/IPS, and access authentication work.',
      'Rebuilt network documentation, including IP inventory, topology, architecture white papers, and ITSM-based operations processes.',
    ],
  },
  {
    title: 'Network Engineer',
    company: 'Kingsoft Seasun - Zhuhai, China',
    period: '2015.08 - 2021.01',
    stack: ['IDC', 'OSPF', 'EVPN', 'VXLAN', 'H3C 6800', 'Python', 'Golang', 'Kubernetes', 'Zabbix'],
    bullets: [
      'Owned network architecture, operations, expansion, and optimization for Kingsoft Seasun game IDC environments.',
      'Consolidated IDC resources across Shanghai, Beijing, and Guangzhou, reducing rack and leased-line costs while improving internal network connectivity.',
      'Built EVPN/VXLAN with H3C 6800 for cross-data-center same-subnet requirements and completed SDN architecture in Kingsoft Software Park.',
      'Developed Python scripts for device configuration backup, traffic weekly reports, and daily operations; participated in Golang-based CMDB and workflow reconstruction.',
      'Built Kubernetes in hosted IDC virtualization environments and supported migration of official website services to containers.',
    ],
  },
  {
    title: 'Network Engineer',
    company: 'Sky-Tech Smart Cloud - Guangzhou, China',
    period: '2014.05 - 2015.08',
    stack: ['Cisco Webex DC', 'BSS', 'Media Gateway', 'IDC', 'Office Network', 'Security Policy'],
    bullets: [
      'Built network environments for BSS, Beijing media gateway, Guangzhou office, and Suzhou office projects.',
      'Handled data center site selection, network device selection, network planning, IDC uplink selection, and project delivery control.',
      'Connected Beijing Cisco data center, Webex data center, APAC BSS site, media gateway site, and office networks with security policies.',
      'Built the Beijing Zhaowei Webex data center network and APAC BSS network.',
    ],
  },
  {
    title: 'Network Engineer',
    company: 'CNLink Networks - Beijing, China',
    period: '2011.11 - 2014.05',
    stack: ['BGP', 'MPLS/VPN', 'Cisco Nexus 7018', 'ASA', 'IDS', 'Traffic Scrubbing', 'VMware'],
    bullets: [
      'Built and operated IDC networks and maintained a global BGP MPLS/VPN backbone across 24 POP sites.',
      'Planned new POP sites using BGP confederation, AS-PATH, and MED to control forward and return paths.',
      'Delivered China Mobile Southern Base cloud data center phase-two network optimization.',
      'Migrated service gateways from Cisco ASA to Nexus 7018, added IDS and traffic scrubbing capabilities, and improved cloud host security protection.',
      'Completed backbone POP construction in Dalian, Wuhan, Changsha, Wuxi, and other cities.',
    ],
  },
  {
    title: 'Network Engineer',
    company: 'China Digital Group - Guangzhou / Hong Kong',
    period: '2009.03 - 2011.11',
    stack: ['Cisco 3750', 'Cisco 2960', 'F5 BIG-IP', 'Citrix NetScaler', 'OSPF', 'EIGRP', 'STP', 'DDoS Protection'],
    bullets: [
      'Operated Guangzhou Qixinggang South China IDC and Hong Kong PCCW IDC networks, including ISP circuits and daily facility network operations.',
      'Designed, configured, and implemented new network requirements for production systems and provided network technical support to internal teams.',
      'Built active/standby load balancing with F5 BIG-IP and NetScaler to remove single points of failure.',
      'Optimized Layer 2 physical structure, STP, safety protection, OSPF and EIGRP filtering to reduce loop and instability risk.',
      'Led Hong Kong HGC data center network construction for overseas mail, DNS, and business-critical systems.',
    ],
  },
];

const projects = [
  {
    name: 'Hybrid Cloud Network Operations for 270+ Companies',
    context:
      'China Resources Gas needed stable connectivity across enterprise networks, IDC data centers, Huawei Cloud, and AWS while supporting a large group-company environment.',
    approach:
      'Operated BGP/MPLS backbone connectivity, OSPF, Cisco firewall ACLs, route policies, AWS VPC and IAM controls, Huawei Cloud access, WAF policies, DNS, VPC Peering, ELB, and security groups.',
    result:
      'Maintained 99.9% business availability and reduced intrusion-detection false positives by 15% through RBAC and cloud security policy improvements.',
    description:
      'Enterprise-to-cloud network operations across IDC, AWS, Huawei Cloud, BGP/MPLS, firewalls, WAF, and IAM security controls.',
    tags: ['BGP/MPLS', 'AWS', 'Huawei Cloud', 'WAF'],
  },
  {
    name: 'Global SD-WAN Optimization for 200+ Sites',
    context:
      'Branch offices and global sites relied on traditional BGP-based dual-line backup for headquarters access, affecting cost, failover, and centralized management.',
    approach:
      'Replaced the legacy design with Fortinet SD-WAN, enabling intelligent path selection, faster failover, centralized traffic control, and better service continuity for OA, email, and Cisco TelePresence.',
    result:
      'Improved availability from 99% to 99.9% and reduced annual operational costs by more than RMB 6 million.',
    description:
      'Fortinet SD-WAN migration for 200+ global sites, improving failover behavior, centralizing traffic management, and cutting annual costs.',
    tags: ['Fortinet', 'SD-WAN', 'BGP', 'WAN'],
  },
  {
    name: 'IDC EVPN/VXLAN Migration and SDN Fabric',
    context:
      'Business migration between Beijing and Guangzhou required preserving internal IP addressing while modernizing data center network architecture.',
    approach:
      'Designed and implemented H3C 6800 EVPN/VXLAN migration, SDN Fabric architecture, policy-based networking, OSPF path control, and IDC disaster recovery drill procedures.',
    result:
      'Enabled smoother workload transition, improved network agility, reduced MSTP leased bandwidth by 70M, and lowered monthly operating cost by RMB 70,000.',
    description:
      'Data center migration using H3C 6800 EVPN/VXLAN to preserve internal IP addressing during workload transition.',
    tags: ['EVPN', 'VXLAN', 'H3C', 'IDC'],
  },
  {
    name: 'Network Automation and CMDB Modernization',
    context:
      'Daily operations required repeatable device backups, traffic reports, maintenance workflows, and better asset data performance.',
    approach:
      'Built Python automation using Paramiko, Netmiko, and Zabbix API, and contributed to CMDB migration from Python to Golang with the development team.',
    result:
      'Improved operational efficiency, boosted CMDB performance by 30%, and improved scalability by 50%.',
    description:
      'Automation for device backups, traffic reporting, and operations workflows using Python, Netmiko, Paramiko, Zabbix API, and Golang CMDB improvements.',
    tags: ['Python', 'Golang', 'Zabbix API', 'CMDB'],
  },
];

const certifications = [
  'AWS Certified Advanced Networking - Specialty, July 2025',
  'AWS Certified Solutions Architect - Associate, July 2025',
  'Oracle AI Vector Search Certified Professional, July 2025',
  'MySQL 8.0 Database Administrator, June 2025',
  'Oracle Cloud Infrastructure Certified Architect Associate, Sep 2023',
  'VMware Certified Professional, Mar 2013',
  'Cisco Certified Network Professional, Dec 2008',
];

const education = [
  'Guangxi Normal University - Master in Business Administration, June 2018',
];

const articles = [
  {
    title: 'How I Troubleshoot BGP Route Flapping in a Production Network',
    description:
      'A practical troubleshooting workflow for route instability, including symptoms, evidence collection, peer checks, policy review, and safe remediation.',
    href: '/writing/bgp-route-flapping/',
  },
  {
    title: 'Designing Hybrid Cloud Networking Between On-Prem and AWS',
    description:
      'Design notes for connecting enterprise networks, data centers, and AWS with attention to routing, segmentation, security, observability, and failure domains.',
    href: '/writing/hybrid-cloud-networking-aws/',
  },
  {
    title: 'From Traditional Network Engineer to Cloud Network Engineer',
    description:
      'A field-oriented view of how routing, security, automation, and operations skills evolve when moving from hardware-centric networks to cloud networking.',
    href: '/writing/traditional-to-cloud-network-engineer/',
  },
];

const periodPoints = (period: string) => {
  const [start, end] = period.split(' - ');
  return { start, end };
};

const shouldShowEndPoint = (index: number) => {
  if (index === 0) {
    return true;
  }

  return periodPoints(experiences[index - 1].period).start !== periodPoints(experiences[index].period).end;
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name} - ${profile.role} portfolio`} />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name} | {profile.role}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">{profile.name}</a>
      <nav aria-label="Main navigation">
        <a href="#skills">Skills</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Case Studies</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{profile.location}</p>
          <h1>{profile.name}</h1>
          <p class="role">{profile.role} / Network Architect / Cloud Networking</p>
          <p class="summary">{profile.summary}</p>
          <div class="actions">
            <a class="button primary" href={`mailto:${profile.email}`}>Email Me</a>
            <a class="button" href={profile.linkedin}>LinkedIn</a>
            <a class="button" href={profile.github}>GitHub</a>
          </div>
        </div>
        <aside class="hero-visual" aria-label="Profile photo and professional focus">
          <img src="/images/profile-toronto-waterfront.jpg" alt="Dongxu Allen Hu near the Toronto waterfront" />
          <div class="hero-panel">
            <span>Focus</span>
            <strong>Reliable networks, clean documentation, faster troubleshooting.</strong>
            <p>Hybrid cloud networking, SDN, SD-WAN, IDC operations, security controls, and practical automation.</p>
          </div>
        </aside>
      </section>

      <section class="metrics" aria-label="Career highlights">
        {metrics.map((metric) => (
          <article>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </article>
        ))}
      </section>

      <section class="section split certs-feature">
        <div>
          <p class="eyebrow">Credentials</p>
          <h2>Certifications</h2>
        </div>
        <ul class="cert-list">
          {certifications.map((cert) => <li>{cert}</li>)}
        </ul>
      </section>

      <section class="section" id="skills">
        <div class="section-heading">
          <p class="eyebrow">Expertise</p>
          <h2>What I Work On</h2>
        </div>
        <div class="skill-grid">
          {skills.map((skill) => (
            <article class="card">
              <h3>{skill.group}</h3>
              <div class="tags">
                {skill.items.map((item) => <span>{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="projects">
        <div class="section-heading">
          <p class="eyebrow">Selected Work</p>
          <h2>Case Studies</h2>
        </div>
        <div class="case-grid">
          {projects.map((project) => (
            <article class="case-card">
              <div>
                <h3>{project.name}</h3>
                <p>{project.description}</p>
              </div>
              <dl>
                <dt>Context</dt>
                <dd>{project.context}</dd>
                <dt>Approach</dt>
                <dd>{project.approach}</dd>
                <dt>Result</dt>
                <dd>{project.result}</dd>
              </dl>
              <div class="tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="experience">
        <div class="section-heading">
          <p class="eyebrow">Career Timeline</p>
          <h2>Experience</h2>
        </div>
        <div class="timeline">
          {experiences.map((job, index) => (
            <article class="timeline-item">
              <div class={`timeline-date ${shouldShowEndPoint(index) ? '' : 'single-start'}`}>
                {shouldShowEndPoint(index) && <time class="time-point time-end">{periodPoints(job.period).end}</time>}
                <time class="time-point time-start">{periodPoints(job.period).start}</time>
              </div>
              <div class="timeline-content">
                <div class="timeline-main">
                  <h3>{job.title}</h3>
                  <p>{job.company}</p>
                  <ul>
                    {job.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                </div>
                <div class="timeline-stack">
                  {job.stack.map((item) => <span>{item}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section split">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>Technical Articles</h2>
        </div>
        <div class="article-list">
          {articles.map((article) => (
            <a class="article-link" href={article.href}>
              <span>{article.title}</span>
              <p>{article.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="section split">
        <div>
          <p class="eyebrow">Education</p>
          <h2>Education</h2>
        </div>
        <ul class="cert-list">
          {education.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="contact" id="contact">
        <p class="eyebrow">Contact</p>
        <h2>Let us connect.</h2>
        <p>For opportunities, collaboration, or technical conversations, reach me through email or LinkedIn.</p>
        <div class="actions">
          <a class="button primary" href={`mailto:${profile.email}`}>Email</a>
          <a class="button" href={profile.linkedin}>LinkedIn</a>
          <a class="button" href={profile.github}>GitHub</a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f8f3;
    --ink: #18211f;
    --muted: #64716c;
    --line: #d9ded7;
    --panel: #ffffff;
    --accent: #0f766e;
    --accent-dark: #115e59;
    --warm: #d97706;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    left: 0;
    padding: 18px clamp(20px, 5vw, 72px);
    position: sticky;
    right: 0;
    top: 0;
    z-index: 10;
    width: 100%;
  }

  .brand {
    font-weight: 800;
  }

  nav {
    color: var(--muted);
    display: flex;
    font-size: 0.94rem;
    gap: 22px;
  }

  main {
    margin: 0 auto;
    max-width: 2160px;
    padding: 0 clamp(24px, 2vw, 44px) 56px;
    width: 100%;
  }

  .hero {
    align-items: center;
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(760px, 1.12fr) minmax(340px, 0.68fr);
    min-height: clamp(560px, calc(100vh - 72px), 760px);
    padding: 48px 0;
  }

  .hero-copy {
    max-width: 1040px;
    min-width: 0;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(3rem, 6.2vw, 5.8rem);
    line-height: 1;
    margin-bottom: 18px;
    white-space: nowrap;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1;
    margin-bottom: 0;
  }

  h3 {
    font-size: 1.08rem;
    margin-bottom: 12px;
  }

  .role {
    color: var(--warm);
    font-size: clamp(1.2rem, 3vw, 1.75rem);
    font-weight: 800;
    margin-bottom: 20px;
  }

  .summary {
    color: var(--muted);
    font-size: 1.16rem;
    line-height: 1.7;
    max-width: 680px;
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: inline-flex;
    font-weight: 800;
    min-height: 44px;
    padding: 0 18px;
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .hero-panel,
  .card,
  .timeline-item,
  .contact {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(24, 33, 31, 0.06);
  }

  .hero-visual {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .hero-visual img {
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(24, 33, 31, 0.08);
    display: block;
    object-fit: cover;
    object-position: 54% 46%;
    width: 100%;
  }

  .hero-panel {
    min-width: 0;
    padding: 28px;
    width: 100%;
  }

  .hero-panel span {
    color: var(--muted);
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .hero-panel strong {
    display: block;
    font-size: 1.4rem;
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .hero-panel p,
  .card p,
  .timeline-item p,
  .contact p {
    color: var(--muted);
    line-height: 1.65;
  }

  .section {
    border-top: 1px solid var(--line);
    padding: 64px 0;
  }

  .metrics {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 34px 0 64px;
  }

  .metrics article {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: 160px;
    padding: 22px;
  }

  .metrics strong {
    color: var(--accent);
    display: block;
    font-size: clamp(2.2rem, 5vw, 3.7rem);
    line-height: 1;
    margin-bottom: 18px;
  }

  .metrics span {
    color: var(--muted);
    display: block;
    font-weight: 700;
    line-height: 1.45;
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .skill-grid,
  .project-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .case-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .case-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    padding: 26px;
  }

  .case-card h3 {
    font-size: 1.34rem;
  }

  .case-card dl {
    display: grid;
    gap: 10px 16px;
    grid-template-columns: 94px minmax(0, 1fr);
    margin: 0;
  }

  .case-card dt {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .case-card dd {
    color: var(--muted);
    line-height: 1.58;
    margin: 0;
  }

  .card {
    min-height: 180px;
    min-width: 0;
    padding: 22px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags span {
    background: #eef4ef;
    border: 1px solid #dce7df;
    border-radius: 999px;
    color: #2f4842;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 7px 10px;
  }

  .timeline {
    display: grid;
    gap: 8px;
    margin: 0 auto;
    max-width: none;
    position: relative;
    width: 100%;
  }

  .timeline::before {
