---
const profile = {
  name: 'Allen Hu',
  role: 'Network Engineer',
  location: 'Toronto, Canada',
  summary:
    'I build reliable networks, troubleshoot production issues, and document systems so teams can operate with confidence.',
  email: 'your.email@example.com',
  linkedin: 'https://www.linkedin.com/in/your-linkedin/',
  github: 'https://github.com/your-github-username',
};

const skills = [
  {
    group: 'Networking',
    items: ['Routing', 'Switching', 'VLANs', 'VPN', 'Firewall', 'TCP/IP', 'DNS', 'DHCP'],
  },
  {
    group: 'Systems',
    items: ['Windows Server', 'Linux', 'Active Directory', 'VMware', 'Microsoft 365'],
  },
  {
    group: 'Tools',
    items: ['Wireshark', 'PuTTY', 'Tftpd64', 'GitHub', 'PowerShell', 'Python'],
  },
  {
    group: 'Operations',
    items: ['Incident response', 'Monitoring', 'Documentation', 'Change management'],
  },
];

const experiences = [
  {
    title: 'Network Engineer',
    company: 'Company Name',
    period: '2023 - Present',
    bullets: [
      'Supported LAN/WAN operations across routing, switching, wireless, VPN, and firewall environments.',
      'Troubleshot connectivity, DNS, DHCP, and endpoint access issues across Windows and network systems.',
      'Improved repeatable operational work with clear documentation and PowerShell-based checks.',
    ],
  },
  {
    title: 'IT Support / Infrastructure Specialist',
    company: 'Company Name',
    period: 'Previous Role',
    bullets: [
      'Handled user support, device setup, software troubleshooting, and escalation for infrastructure issues.',
      'Maintained internal tools and reduced recurring problems through clearer procedures and checklists.',
    ],
  },
];

const projects = [
  {
    name: 'Home Media Server',
    description:
      'Built a local Jellyfin media service on Windows for Mac, phone, and TV access across the home network.',
    tags: ['Windows', 'Jellyfin', 'Firewall', 'LAN'],
  },
  {
    name: 'Network Troubleshooting Toolkit',
    description:
      'A personal collection of PowerShell commands, packet-capture notes, and repeatable checks for network diagnosis.',
    tags: ['PowerShell', 'Wireshark', 'DNS', 'DHCP'],
  },
  {
    name: 'Portfolio Website',
    description:
      'This Astro and GitHub Pages site for presenting technical experience, projects, and contact links.',
    tags: ['Astro', 'GitHub Pages', 'HTML', 'CSS'],
  },
];

const certifications = ['CCNA - planned or completed', 'Microsoft / Azure - optional', 'Security+ - optional'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name} - ${profile.role} portfolio`} />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name} | {profile.role}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">{profile.name}</a>
      <nav aria-label="Main navigation">
        <a href="#skills">Skills</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{profile.location}</p>
          <h1>{profile.name}</h1>
          <p class="role">{profile.role} / IT Infrastructure</p>
          <p class="summary">{profile.summary}</p>
          <div class="actions">
            <a class="button primary" href={`mailto:${profile.email}`}>Email Me</a>
            <a class="button" href={profile.linkedin}>LinkedIn</a>
            <a class="button" href={profile.github}>GitHub</a>
          </div>
        </div>
        <aside class="hero-panel" aria-label="Professional focus">
          <span>Focus</span>
          <strong>Reliable networks, clean documentation, faster troubleshooting.</strong>
          <p>LAN/WAN operations, firewall access, endpoint connectivity, and practical automation.</p>
        </aside>
      </section>

      <section class="section" id="skills">
        <div class="section-heading">
          <p class="eyebrow">Capabilities</p>
          <h2>Skills</h2>
        </div>
        <div class="skill-grid">
          {skills.map((skill) => (
            <article class="card">
              <h3>{skill.group}</h3>
              <div class="tags">
                {skill.items.map((item) => <span>{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="experience">
        <div class="section-heading">
          <p class="eyebrow">Background</p>
          <h2>Experience</h2>
        </div>
        <div class="timeline">
          {experiences.map((job) => (
            <article class="timeline-item">
              <div>
                <h3>{job.title}</h3>
                <p>{job.company}</p>
              </div>
              <span>{job.period}</span>
              <ul>
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="projects">
        <div class="section-heading">
          <p class="eyebrow">Proof of Work</p>
          <h2>Projects</h2>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="card project">
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <div class="tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section split">
        <div>
          <p class="eyebrow">Credentials</p>
          <h2>Certifications</h2>
        </div>
        <ul class="cert-list">
          {certifications.map((cert) => <li>{cert}</li>)}
        </ul>
      </section>

      <section class="contact" id="contact">
        <p class="eyebrow">Contact</p>
        <h2>Let us connect.</h2>
        <p>For opportunities, collaboration, or technical conversations, reach me through email or LinkedIn.</p>
        <div class="actions">
          <a class="button primary" href={`mailto:${profile.email}`}>Email</a>
          <a class="button" href={profile.linkedin}>LinkedIn</a>
          <a class="button" href={profile.github}>GitHub</a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f8f3;
    --ink: #18211f;
    --muted: #64716c;
    --line: #d9ded7;
    --panel: #ffffff;
    --accent: #0f766e;
    --accent-dark: #115e59;
    --warm: #d97706;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    left: 0;
    padding: 18px clamp(20px, 5vw, 72px);
    position: sticky;
    right: 0;
    top: 0;
    z-index: 10;
    width: 100%;
  }

  .brand {
    font-weight: 800;
  }

  nav {
    color: var(--muted);
    display: flex;
    font-size: 0.94rem;
    gap: 22px;
  }

  main {
    margin: 0 auto;
    max-width: 1180px;
    padding: 0 clamp(20px, 5vw, 72px) 56px;
    width: 100%;
  }

  .hero {
    align-items: center;
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.55fr);
    min-height: clamp(560px, calc(100vh - 72px), 760px);
    padding: 48px 0;
  }

  .hero-copy {
    max-width: 760px;
    min-width: 0;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(3.3rem, 9vw, 7.8rem);
    line-height: 0.92;
    margin-bottom: 18px;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1;
    margin-bottom: 0;
  }

  h3 {
    font-size: 1.08rem;
    margin-bottom: 12px;
  }

  .role {
    color: var(--warm);
    font-size: clamp(1.2rem, 3vw, 1.75rem);
    font-weight: 800;
    margin-bottom: 20px;
  }

  .summary {
    color: var(--muted);
    font-size: 1.16rem;
    line-height: 1.7;
    max-width: 680px;
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: inline-flex;
    font-weight: 800;
    min-height: 44px;
    padding: 0 18px;
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .hero-panel,
  .card,
  .timeline-item,
  .contact {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(24, 33, 31, 0.06);
  }

  .hero-panel {
    min-width: 0;
    padding: 28px;
    width: 100%;
  }

  .hero-panel span {
    color: var(--muted);
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .hero-panel strong {
    display: block;
    font-size: 1.4rem;
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .hero-panel p,
  .card p,
  .timeline-item p,
  .contact p {
    color: var(--muted);
    line-height: 1.65;
  }

  .section {
    border-top: 1px solid var(--line);
    padding: 64px 0;
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .skill-grid,
  .project-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .card {
    min-height: 180px;
    min-width: 0;
    padding: 22px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags span {
    background: #eef4ef;
    border: 1px solid #dce7df;
    border-radius: 999px;
    color: #2f4842;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 7px 10px;
  }

  .timeline {
    display: grid;
    gap: 16px;
  }

  .timeline-item {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(180px, 0.8fr) 150px minmax(0, 1.8fr);
    padding: 24px;
    min-width: 0;
  }

  .timeline-item > span {
    color: var(--accent-dark);
    font-weight: 800;
  }

  ul {
    margin: 0;
    padding-left: 20px;
  }

  li {
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 8px;
  }

  .split {
    align-items: start;
    display: grid;
    gap: 32px;
    grid-template-columns: 0.8fr 1.2fr;
  }

  .cert-list {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    list-style: none;
    padding: 22px 26px;
  }

  .contact {
    margin-top: 32px;
    padding: clamp(28px, 6vw, 56px);
  }

  @media (max-width: 860px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      padding-left: 24px;
      padding-right: 24px;
    }

    nav {
      flex-wrap: wrap;
      gap: 14px;
    }

    .hero,
    .timeline-item,
    .split {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 56px;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 4rem);
    }

    .role {
      font-size: 1.18rem;
      line-height: 1.25;
    }

    .summary {
      font-size: 1.04rem;
      max-width: calc(100vw - 48px);
    }

    .skill-grid,
    .project-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
