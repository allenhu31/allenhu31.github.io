---
const profile = {
  name: 'Dongxu (Allen) Hu',
  role: 'Senior Network Engineer',
  location: 'Toronto, Canada',
  summary:
    'Senior network engineer and network architect with experience in large-scale enterprise networks, hybrid cloud connectivity, SDN, SD-WAN, security operations, automation, and 24/7 infrastructure reliability.',
  email: 'hudongxu31@gmail.com',
  linkedin: 'https://www.linkedin.com/in/your-linkedin/',
  github: 'https://github.com/allenhu31',
};

const skills = [
  {
    group: 'Networking',
    items: ['BGP', 'OSPF', 'EIGRP', 'MPLS', 'VLAN', 'STP', 'VPN', 'NAT', 'DHCP', 'QoS', 'VRRP'],
  },
  {
    group: 'Cloud & SDN',
    items: ['AWS', 'GCP', 'Huawei Cloud', 'VMware NSX', 'H3C Fabric', 'VXLAN', 'SD-WAN'],
  },
  {
    group: 'Automation & Platforms',
    items: ['Python', 'Golang', 'Ansible', 'CI/CD', 'Docker', 'Kubernetes', 'Prometheus', 'Grafana', 'Zabbix'],
  },
  {
    group: 'Security & Troubleshooting',
    items: ['Cisco ASA', 'Fortinet', 'Palo Alto', 'WAF', 'DDoS Protection', 'IDS/IPS', 'Wireshark', 'Tcpdump', 'MTR'],
  },
];

const experiences = [
  {
    title: 'Senior Engineer',
    company: 'China Resources Gas Co., Ltd - Zhongshan, China',
    period: 'Jan 2023 - Feb 2024',
    bullets: [
      'Managed hybrid network infrastructure for 270+ member companies, connecting enterprise networks, IDC data centers, Huawei Cloud, and AWS through BGP/MPLS telecom backbone services.',
      'Led daily operations for BGP/MPLS, OSPF, Cisco firewalls, ACL policies, route policies, and public cloud connectivity, maintaining 99.9% business availability.',
      'Optimized AWS and Huawei Cloud security operations across VPC, EC2, IAM, Lambda, WAF, security groups, Route 53, VPC Peering, ELB, and cloud database security.',
      'Implemented IAM role-based access control and security policy improvements, reducing intrusion-detection false positives by 15%.',
    ],
  },
  {
    title: 'Network Architect',
    company: 'Sangfor Technologies Inc. - Shenzhen, China',
    period: 'Jan 2021 - Dec 2022',
    bullets: [
      'Led VMware NSX-T deployment and upgrade in a new data center, replacing NSX-V and integrating vCenter Server, ESXi transport nodes, NSX Edge, and NSX Manager.',
      'Optimized switching, routing, load balancing, firewalling, VPN services, and SDN troubleshooting practices for the engineering team.',
      'Led WAN optimization for 200+ global sites connected to headquarters, replacing traditional BGP dual-line backup with Fortinet SD-WAN.',
      'Improved availability from 99% to 99.9% and reduced annual operational costs by more than ¥6 million RMB through smarter redundancy and bandwidth usage.',
    ],
  },
  {
    title: 'Senior Network Engineer',
    company: 'Kingsoft Seasun - Zhuhai, China',
    period: 'Aug 2015 - Jan 2021',
    bullets: [
      'Expanded the network operations team from 2 to 7 members, adding network engineers, a monitoring engineer, and 24/7 monitoring operators.',
      'Built Python automation with Paramiko, Netmiko, and Zabbix API for configuration backup, routine maintenance, and traffic reporting; contributed to CMDB migration from Python to Golang.',
      'Deployed Kubernetes and migrated website services from VMs to Kubernetes, improving resource utilization by 40% and reducing deployment time by 70%.',
      'Led IDC network optimization across Beijing, Shanghai, and Guangzhou POP sites, using OSPF path control to reduce MSTP leased bandwidth by 70M and save ¥70,000 per month.',
      'Designed H3C EVPN/VXLAN migration and SDN Fabric architecture, plus disaster recovery drills for a Guangzhou IDC with 180+ racks and dual ISP uplinks.',
    ],
  },
];

const projects = [
  {
    name: 'Hybrid Cloud Network Operations',
    description:
      'Enterprise-to-cloud network operations across IDC, AWS, Huawei Cloud, BGP/MPLS, firewalls, WAF, and IAM security controls.',
    tags: ['BGP/MPLS', 'AWS', 'Huawei Cloud', 'WAF'],
  },
  {
    name: 'Global SD-WAN Optimization',
    description:
      'Fortinet SD-WAN migration for 200+ global sites, improving failover behavior, centralizing traffic management, and cutting annual costs.',
    tags: ['Fortinet', 'SD-WAN', 'BGP', 'WAN'],
  },
  {
    name: 'IDC EVPN/VXLAN Migration',
    description:
      'Data center migration using H3C 6800 EVPN/VXLAN to preserve internal IP addressing during workload transition.',
    tags: ['EVPN', 'VXLAN', 'H3C', 'IDC'],
  },
  {
    name: 'Network Automation & CMDB',
    description:
      'Automation for device backups, traffic reporting, and operations workflows using Python, Netmiko, Paramiko, Zabbix API, and Golang CMDB improvements.',
    tags: ['Python', 'Golang', 'Zabbix API', 'CMDB'],
  },
];

const certifications = [
  'AWS Certified Advanced Networking - Specialty, July 2025',
  'AWS Certified Solutions Architect - Associate, July 2025',
  'Oracle AI Vector Search Certified Professional, July 2025',
  'MySQL 8.0 Database Administrator, June 2025',
  'Oracle Cloud Infrastructure Certified Architect Associate, Sep 2023',
  'VMware Certified Professional, Mar 2013',
  'Cisco Certified Network Professional, Dec 2008',
];

const education = [
  'Guangxi Normal University - Master in Business Administration, June 2018',
  'Hunan College of Information - Electrical Automation, June 2009',
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name} - ${profile.role} portfolio`} />
    <meta name="generator" content={Astro.generator} />
    <title>{profile.name} | {profile.role}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">{profile.name}</a>
      <nav aria-label="Main navigation">
        <a href="#skills">Skills</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{profile.location}</p>
          <h1>{profile.name}</h1>
          <p class="role">{profile.role} / Network Architect / Cloud Networking</p>
          <p class="summary">{profile.summary}</p>
          <div class="actions">
            <a class="button primary" href={`mailto:${profile.email}`}>Email Me</a>
            <a class="button" href={profile.linkedin}>LinkedIn</a>
            <a class="button" href={profile.github}>GitHub</a>
          </div>
        </div>
        <aside class="hero-panel" aria-label="Professional focus">
          <span>Focus</span>
          <strong>Reliable networks, clean documentation, faster troubleshooting.</strong>
          <p>Hybrid cloud networking, SDN, SD-WAN, IDC operations, security controls, and practical automation.</p>
        </aside>
      </section>

      <section class="section" id="skills">
        <div class="section-heading">
          <p class="eyebrow">Capabilities</p>
          <h2>Skills</h2>
        </div>
        <div class="skill-grid">
          {skills.map((skill) => (
            <article class="card">
              <h3>{skill.group}</h3>
              <div class="tags">
                {skill.items.map((item) => <span>{item}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="experience">
        <div class="section-heading">
          <p class="eyebrow">Background</p>
          <h2>Experience</h2>
        </div>
        <div class="timeline">
          {experiences.map((job) => (
            <article class="timeline-item">
              <div>
                <h3>{job.title}</h3>
                <p>{job.company}</p>
              </div>
              <span>{job.period}</span>
              <ul>
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="projects">
        <div class="section-heading">
          <p class="eyebrow">Proof of Work</p>
          <h2>Projects</h2>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="card project">
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <div class="tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section split">
        <div>
          <p class="eyebrow">Credentials</p>
          <h2>Certifications</h2>
        </div>
        <ul class="cert-list">
          {certifications.map((cert) => <li>{cert}</li>)}
        </ul>
      </section>

      <section class="section split">
        <div>
          <p class="eyebrow">Education</p>
          <h2>Education</h2>
        </div>
        <ul class="cert-list">
          {education.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="contact" id="contact">
        <p class="eyebrow">Contact</p>
        <h2>Let us connect.</h2>
        <p>For opportunities, collaboration, or technical conversations, reach me through email or LinkedIn.</p>
        <div class="actions">
          <a class="button primary" href={`mailto:${profile.email}`}>Email</a>
          <a class="button" href={profile.linkedin}>LinkedIn</a>
          <a class="button" href={profile.github}>GitHub</a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f8f3;
    --ink: #18211f;
    --muted: #64716c;
    --line: #d9ded7;
    --panel: #ffffff;
    --accent: #0f766e;
    --accent-dark: #115e59;
    --warm: #d97706;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    left: 0;
    padding: 18px clamp(20px, 5vw, 72px);
    position: sticky;
    right: 0;
    top: 0;
    z-index: 10;
    width: 100%;
  }

  .brand {
    font-weight: 800;
  }

  nav {
    color: var(--muted);
    display: flex;
    font-size: 0.94rem;
    gap: 22px;
  }

  main {
    margin: 0 auto;
    max-width: 1180px;
    padding: 0 clamp(20px, 5vw, 72px) 56px;
    width: 100%;
  }

  .hero {
    align-items: center;
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.55fr);
    min-height: clamp(560px, calc(100vh - 72px), 760px);
    padding: 48px 0;
  }

  .hero-copy {
    max-width: 760px;
    min-width: 0;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(3rem, 7.2vw, 5.8rem);
    line-height: 1;
    margin-bottom: 18px;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1;
    margin-bottom: 0;
  }

  h3 {
    font-size: 1.08rem;
    margin-bottom: 12px;
  }

  .role {
    color: var(--warm);
    font-size: clamp(1.2rem, 3vw, 1.75rem);
    font-weight: 800;
    margin-bottom: 20px;
  }

  .summary {
    color: var(--muted);
    font-size: 1.16rem;
    line-height: 1.7;
    max-width: 680px;
    overflow-wrap: anywhere;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    display: inline-flex;
    font-weight: 800;
    min-height: 44px;
    padding: 0 18px;
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
  }

  .hero-panel,
  .card,
  .timeline-item,
  .contact {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(24, 33, 31, 0.06);
  }

  .hero-panel {
    min-width: 0;
    padding: 28px;
    width: 100%;
  }

  .hero-panel span {
    color: var(--muted);
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .hero-panel strong {
    display: block;
    font-size: 1.4rem;
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .hero-panel p,
  .card p,
  .timeline-item p,
  .contact p {
    color: var(--muted);
    line-height: 1.65;
  }

  .section {
    border-top: 1px solid var(--line);
    padding: 64px 0;
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .skill-grid,
  .project-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .card {
    min-height: 180px;
    min-width: 0;
    padding: 22px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags span {
    background: #eef4ef;
    border: 1px solid #dce7df;
    border-radius: 999px;
    color: #2f4842;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 7px 10px;
  }

  .timeline {
    display: grid;
    gap: 16px;
  }

  .timeline-item {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(180px, 0.8fr) 150px minmax(0, 1.8fr);
    padding: 24px;
    min-width: 0;
  }

  .timeline-item > span {
    color: var(--accent-dark);
    font-weight: 800;
  }

  ul {
    margin: 0;
    padding-left: 20px;
  }

  li {
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 8px;
  }

  .split {
    align-items: start;
    display: grid;
    gap: 32px;
    grid-template-columns: 0.8fr 1.2fr;
  }

  .cert-list {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    list-style: none;
    padding: 22px 26px;
  }

  .contact {
    margin-top: 32px;
    padding: clamp(28px, 6vw, 56px);
  }

  @media (max-width: 860px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      padding-left: 24px;
      padding-right: 24px;
    }

    nav {
      flex-wrap: wrap;
      gap: 14px;
    }

    .hero,
    .timeline-item,
    .split {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
      padding-top: 56px;
    }

    h1 {
      font-size: clamp(3rem, 14vw, 4rem);
    }

    .role {
      font-size: 1.18rem;
      line-height: 1.25;
    }

    .summary {
      font-size: 1.04rem;
      max-width: calc(100vw - 48px);
    }

    .skill-grid,
    .project-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
