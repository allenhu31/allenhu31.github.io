---
const diagrams = [
  {
    title: 'CNLink Backbone Network Topology',
    description:
      'Original backbone topology showing multi-city POP connectivity, AS design, carrier bandwidth, routing domains, and regional interconnection paths.',
    image: '/images/work/cnlink-topology/cnlink-backbone.png',
  },
  {
    title: 'China Mobile Southern Base Cloud Network',
    description:
      'Original cloud network architecture diagram using Nexus 7018, Nexus 5545, Nexus 2048, firewalls, load balancers, IDS, and management network zones.',
    image: '/images/work/cnlink-topology/china-mobile-cloud.jpg',
  },
  {
    title: 'Second Floor Production Network Topology',
    description:
      'Original production network topology showing core, distribution, routing, security, and access-layer connectivity for the second-floor environment.',
    image: '/images/work/cnlink-topology/second-floor-network.jpg',
  },
  {
    title: 'Second Floor Out-of-Band Management Network',
    description:
      'Original OOB management topology showing management switches, firewall paths, device access, and operational management connectivity.',
    image: '/images/work/cnlink-topology/second-floor-oob-management.jpg',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Original CNLink and China Mobile Southern Base topology diagrams from Dongxu Allen Hu's 2011-2014 network engineering experience."
    />
    <meta name="generator" content={Astro.generator} />
    <title>2011-2014 CNLink Topology | Dongxu Allen Hu</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Dongxu (Allen) Hu</a>
      <nav aria-label="Main navigation">
        <a href="/#experience">Experience</a>
        <a href="/#projects">Case Studies</a>
        <a href="/photography/">Photography</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Topology Archive</p>
        <h1>2011-2014 CNLink Cloud & Backbone Topology</h1>
        <p>
          Original network diagrams from the CNLink and China Mobile Southern Base cloud network period. These diagrams
          show the backbone, production, cloud resource pool, and management topology context behind large-scale Nexus
          network operations.
        </p>
      </section>

      <section class="gallery" aria-label="Original CNLink topology diagrams">
        {diagrams.map((diagram, index) => (
          <article class={`diagram-card ${index === 1 ? 'featured' : ''}`}>
            <div class="diagram-copy">
              <p class="eyebrow">Original Diagram</p>
              <h2>{diagram.title}</h2>
              <p>{diagram.description}</p>
            </div>
            <a class="diagram-image" href={diagram.image} target="_blank" rel="noreferrer">
              <img src={diagram.image} alt={diagram.title} loading={index === 0 ? 'eager' : 'lazy'} />
            </a>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f8f3;
    --ink: #18211f;
    --muted: #64716c;
    --line: #d9ded7;
    --panel: #ffffff;
    --accent: #0f766e;
    --accent-dark: #115e59;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    padding: 18px clamp(20px, 5vw, 72px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .brand {
    font-weight: 800;
  }

  nav {
    color: var(--muted);
    display: flex;
    font-size: 0.94rem;
    gap: 22px;
  }

  main {
    margin: 0 auto;
    max-width: 1900px;
    padding: 56px clamp(20px, 4vw, 72px) 80px;
  }

  .hero {
    border-bottom: 1px solid var(--line);
    padding: 44px 0 38px;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 6.2rem);
    line-height: 0.95;
    margin: 0 0 22px;
    max-width: 1280px;
  }

  h2 {
    font-size: clamp(1.6rem, 2vw, 2.4rem);
    line-height: 1.15;
    margin: 0 0 12px;
  }

  p {
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.72;
    margin: 0;
  }

  .hero p {
    max-width: 1080px;
  }

  .gallery {
    display: grid;
    gap: 26px;
    padding-top: 34px;
  }

  .diagram-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(24, 33, 31, 0.06);
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(280px, 0.34fr) minmax(0, 1fr);
    padding: 24px;
  }

  .diagram-card.featured {
    grid-template-columns: 1fr;
  }

  .diagram-copy {
    align-content: start;
    display: grid;
    gap: 10px;
  }

  .diagram-image {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 6px;
    display: block;
    min-width: 0;
    overflow: auto;
  }

  .diagram-image img {
    display: block;
    height: auto;
    min-width: 900px;
    width: 100%;
  }

  .featured .diagram-image img {
    min-width: 1200px;
  }

  @media (max-width: 860px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    nav {
      flex-wrap: wrap;
    }

    main {
      padding-top: 28px;
    }

    .diagram-card,
    .diagram-card.featured {
      grid-template-columns: 1fr;
      padding: 18px;
    }

    .diagram-image img,
    .featured .diagram-image img {
      min-width: 720px;
    }
  }
</style>
