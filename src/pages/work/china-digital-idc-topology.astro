---
const title = 'China Digital Group IDC Topology | Dongxu Allen Hu';

const stats = [
  ['Period', '2009.03 - 2011.11'],
  ['Environment', 'Guangzhou Qixinggang South China IDC and Hong Kong PCCW IDC'],
  ['Scale', '200+ IDC cabinets and around 500 Cisco switches / routers'],
  ['Core Technologies', 'BGP, OSPF, EIGRP, STP, HSRP, route policy, load balancing, DDoS protection'],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="China Digital Group South China IDC topology summary, 2009 to 2011." />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Dongxu (Allen) Hu</a>
      <nav aria-label="Main navigation">
        <a href="/#experience">Experience</a>
        <a href="/#projects">Case Studies</a>
        <a href="/photography/">Photography</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Topology Archive</p>
        <h1>China Digital Group IDC Network</h1>
        <p>
          A simplified topology view of the 2009-2011 South China IDC backbone, multi-ISP routing, firewall, load
          balancing, and access switching environment.
        </p>
      </section>

      <section class="summary">
        <div class="stats">
          {stats.map(([label, value]) => (
            <article>
              <span>{label}</span>
              <strong>{value}</strong>
            </article>
          ))}
        </div>
      </section>

      <section class="diagram-card">
        <div class="diagram-heading">
          <div>
            <p class="eyebrow">Full Topology</p>
            <h2>Multi-ISP IDC Backbone</h2>
          </div>
          <span>simplified for web display</span>
        </div>

        <svg class="topology" viewBox="0 0 1280 760" role="img" aria-labelledby="topology-title topology-desc">
          <title id="topology-title">China Digital Group IDC topology summary</title>
          <desc id="topology-desc">
            Multi-ISP edge routers connect to firewall and core switch layers, then to access switches, load balancers,
            customer cabinets, and Hong Kong business systems.
          </desc>
          <defs>
            <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
              <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#d9ded7" stroke-width="1" />
            </pattern>
            <marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
              <path d="M0,0 L8,4 L0,8 Z" fill="#0f766e" />
            </marker>
          </defs>
          <rect width="1280" height="760" fill="#f7f8f3" />
          <rect width="1280" height="760" fill="url(#grid)" opacity="0.75" />

          <g class="clouds">
            <g transform="translate(70 42)">
              <rect width="190" height="84" rx="42" />
              <text x="95" y="36">Guangzhou Telecom</text>
              <text x="95" y="62">AS 4813</text>
            </g>
            <g transform="translate(365 42)">
              <rect width="170" height="84" rx="42" />
              <text x="85" y="50">Foshan ISP</text>
            </g>
            <g transform="translate(640 42)">
              <rect width="185" height="84" rx="42" />
              <text x="92" y="36">CERNET</text>
              <text x="92" y="62">AS 4538</text>
            </g>
            <g transform="translate(960 42)">
              <rect width="200" height="84" rx="42" />
              <text x="100" y="36">Guangzhou Netcom</text>
              <text x="100" y="62">AS 17622</text>
            </g>
          </g>

          <g class="links">
            <path d="M165 126 L235 225" />
            <path d="M450 126 L450 224" />
            <path d="M732 126 L618 246" />
            <path d="M1058 126 L905 225" />
            <path d="M235 285 L235 368 L360 368" />
            <path d="M450 285 L450 368 L515 368" />
            <path d="M618 306 L618 368 L515 368" />
            <path d="M905 285 L905 368 L740 368" />
            <path d="M360 430 L292 540" />
            <path d="M515 430 L448 540" />
            <path d="M740 430 L808 540" />
            <path d="M920 430 L982 540" />
            <path d="M292 600 L448 600 L808 600 L982 600" />
            <path d="M448 600 L448 668" />
            <path d="M808 600 L808 668" />
            <path d="M982 600 L1095 675" />
          </g>

          <g class="red-links">
            <path d="M360 368 L515 368" />
            <path d="M740 368 L920 368" />
            <path d="M292 540 L448 600" />
            <path d="M808 540 L982 600" />
          </g>

          <g class="device router" transform="translate(185 218)">
            <rect width="100" height="66" rx="14" />
            <text x="50" y="38">Cisco 7609</text>
          </g>
          <g class="device switch" transform="translate(400 218)">
            <rect width="100" height="66" rx="10" />
            <text x="50" y="38">2960G</text>
          </g>
          <g class="device router" transform="translate(568 240)">
            <rect width="100" height="66" rx="14" />
            <text x="50" y="38">VPN Edge</text>
          </g>
          <g class="device router" transform="translate(855 218)">
            <rect width="100" height="66" rx="14" />
            <text x="50" y="38">Cisco 12000</text>
          </g>

          <g class="device firewall" transform="translate(172 360)">
            <rect width="126" height="70" rx="14" />
            <text x="63" y="32">Firewall A/B</text>
            <text x="63" y="52">58.63.x.x</text>
          </g>
          <g class="device switch" transform="translate(324 338)">
            <rect width="128" height="90" rx="10" />
            <text x="64" y="40">Cisco 4500</text>
            <text x="64" y="62">IDC Core</text>
          </g>
          <g class="device switch" transform="translate(476 338)">
            <rect width="128" height="90" rx="10" />
            <text x="64" y="40">Cisco 5500</text>
            <text x="64" y="62">Aggregation</text>
          </g>
          <g class="device firewall" transform="translate(682 360)">
            <rect width="126" height="70" rx="14" />
            <text x="63" y="32">Firewall C/D</text>
            <text x="63" y="52">123.100.x.x</text>
          </g>
          <g class="device switch" transform="translate(860 338)">
            <rect width="128" height="90" rx="10" />
            <text x="64" y="40">Cisco 4500</text>
            <text x="64" y="62">IDC Core</text>
          </g>

          <g class="device lb" transform="translate(228 535)">
            <rect width="128" height="70" rx="10" />
            <text x="64" y="32">F5 BIG-IP</text>
            <text x="64" y="52">NetScaler</text>
          </g>
          <g class="device access" transform="translate(384 535)">
            <rect width="128" height="70" rx="10" />
            <text x="64" y="32">Cisco 3750</text>
            <text x="64" y="52">Access</text>
          </g>
          <g class="device access" transform="translate(744 535)">
            <rect width="128" height="70" rx="10" />
            <text x="64" y="32">Cisco 2960</text>
            <text x="64" y="52">Access</text>
          </g>
          <g class="device lb" transform="translate(918 535)">
            <rect width="128" height="70" rx="10" />
            <text x="64" y="32">HSRP Pair</text>
            <text x="64" y="52">Route Policy</text>
          </g>

          <g class="device cabinet" transform="translate(350 668)">
            <rect width="196" height="54" rx="10" />
            <text x="98" y="34">200+ IDC Cabinets</text>
          </g>
          <g class="device cabinet" transform="translate(710 668)">
            <rect width="196" height="54" rx="10" />
            <text x="98" y="34">500+ Cisco Devices</text>
          </g>
          <g class="device cabinet" transform="translate(1030 668)">
            <rect width="170" height="54" rx="10" />
            <text x="85" y="34">Hong Kong Systems</text>
          </g>

          <g class="labels">
            <text x="318" y="314">Static / dynamic links</text>
            <text x="728" y="314">AS 24426 routing zone</text>
            <text x="500" y="472">OSPF / EIGRP filtering</text>
            <text x="710" y="472">BGP + route policy</text>
          </g>
        </svg>
      </section>

      <section class="notes">
        <article>
          <h2>What This Shows</h2>
          <ul>
            <li>Multi-ISP IDC egress with Telecom, Netcom, education network, and regional ISP connectivity.</li>
            <li>Redundant firewall and core switching design for hosted IDC customer networks.</li>
            <li>Route redistribution, BGP policy, OSPF/EIGRP filtering, HSRP, and load balancing control points.</li>
            <li>Operations scope covering IDC access, cabinet network delivery, security isolation, and fault handling.</li>
          </ul>
        </article>
        <article>
          <h2>Original Diagram Notes</h2>
          <p>
            This web version is intentionally simplified for readability. The original topology screenshots include the
            detailed interface names, public IP segments, route redistribution table, and site-specific device naming.
          </p>
        </article>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f8f3;
    --ink: #18211f;
    --muted: #64716c;
    --line: #d9ded7;
    --panel: #ffffff;
    --accent: #0f766e;
    --accent-dark: #115e59;
    --warm: #d97706;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    padding: 18px clamp(20px, 5vw, 72px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .brand {
    font-weight: 800;
  }

  nav {
    color: var(--muted);
    display: flex;
    font-size: 0.94rem;
    gap: 22px;
  }

  main {
    margin: 0 auto;
    max-width: 2160px;
    padding: 56px clamp(24px, 2vw, 44px);
  }

  .hero {
    border-bottom: 1px solid var(--line);
    padding: 44px 0 38px;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 0.95;
    margin: 0 0 18px;
  }

  h2,
  p {
    margin-top: 0;
  }

  .hero p,
  .notes p,
  .notes li {
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.7;
    max-width: 980px;
  }

  .summary {
    padding: 30px 0;
  }

  .stats {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .stats article,
  .diagram-card,
  .notes article {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(24, 33, 31, 0.06);
  }

  .stats article {
    padding: 20px;
  }

  .stats span {
    color: var(--accent-dark);
    display: block;
    font-size: 0.76rem;
    font-weight: 900;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .stats strong {
    display: block;
    line-height: 1.4;
  }

  .diagram-card {
    padding: 26px;
  }

  .diagram-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .diagram-heading h2 {
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1;
    margin-bottom: 0;
  }

  .diagram-heading span {
    color: var(--muted);
    font-weight: 800;
  }

  .topology {
    border: 1px solid var(--line);
    border-radius: 8px;
    display: block;
    height: auto;
    width: 100%;
  }

  .clouds rect,
  .device rect {
    fill: #ffffff;
    stroke: #0f766e;
    stroke-width: 3;
  }

  .clouds text,
  .device text,
  .labels text {
    fill: #18211f;
    font-size: 18px;
    font-weight: 800;
    text-anchor: middle;
  }

  .links path {
    fill: none;
    marker-end: url(#arrow);
    stroke: #18211f;
    stroke-width: 4;
  }

  .red-links path {
    fill: none;
    stroke: #d97706;
    stroke-width: 4;
  }

  .device.router rect {
    fill: #dff3f0;
  }

  .device.switch rect {
    fill: #e7f2ff;
  }

  .device.firewall rect {
    fill: #fff2e5;
  }

  .device.lb rect {
    fill: #edf7ed;
  }

  .device.access rect {
    fill: #eef4ef;
  }

  .device.cabinet rect {
    fill: #f5f7f3;
  }

  .labels text {
    fill: var(--accent-dark);
    font-size: 20px;
  }

  .notes {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr 1fr;
    padding-top: 30px;
  }

  .notes article {
    padding: 26px;
  }

  .notes ul {
    margin: 0;
    padding-left: 20px;
  }

  @media (max-width: 860px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    nav {
      flex-wrap: wrap;
      gap: 14px;
    }

    .stats,
    .notes {
      grid-template-columns: 1fr;
    }

    .diagram-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
