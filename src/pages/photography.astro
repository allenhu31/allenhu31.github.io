---
import { photos } from '../data/photos';

const title = 'Photography | Dongxu Allen Hu';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A personal photography gallery by Dongxu Allen Hu." />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Dongxu (Allen) Hu</a>
      <nav aria-label="Main navigation">
        <a href="/#skills">Skills</a>
        <a href="/#experience">Experience</a>
        <a href="/#projects">Case Studies</a>
        <a href="/photography/">Photography</a>
      </nav>
    </header>

    <main>
      <section class="gallery-hero">
        <p class="eyebrow">Personal Work</p>
        <h1>Photography</h1>
        <p>
          A small collection from my camera and drone: cities, coastlines, travel moments, and quiet scenes outside work.
        </p>
      </section>

      <section class="photo-grid" aria-label="Photography gallery">
        {photos.map((photo) => (
          <a class="photo-card" href={photo.src} target="_blank" rel="noreferrer">
            <img src={photo.thumb} alt={photo.alt} loading="lazy" />
            <span>{photo.type}</span>
          </a>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #f7f8f3;
    --ink: #18211f;
    --muted: #64716c;
    --line: #d9ded7;
    --panel: #ffffff;
    --accent: #0f766e;
    --accent-dark: #115e59;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    left: 0;
    padding: 18px clamp(20px, 5vw, 72px);
    position: sticky;
    right: 0;
    top: 0;
    z-index: 10;
  }

  .brand {
    font-weight: 800;
  }

  nav {
    color: var(--muted);
    display: flex;
    font-size: 0.94rem;
    gap: 22px;
  }

  main {
    margin: 0 auto;
    max-width: 2160px;
    padding: 56px clamp(24px, 2vw, 44px);
  }

  .gallery-hero {
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
    padding: 44px 0 38px;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 6.4rem);
    line-height: 0.95;
    margin: 0 0 18px;
  }

  p {
    color: var(--muted);
    font-size: 1.18rem;
    line-height: 1.7;
    margin: 0;
    max-width: 780px;
  }

  .photo-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .photo-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(24, 33, 31, 0.06);
    display: grid;
    gap: 12px;
    padding: 10px;
  }

  .photo-card img {
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    display: block;
    object-fit: cover;
    width: 100%;
  }

  .photo-card span {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 900;
    padding: 0 4px 4px;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    nav {
      flex-wrap: wrap;
      gap: 14px;
    }

    .photo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
